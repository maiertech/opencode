{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    // If `GITHUB_TOKEN` is present, Copilot models are listed.
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "deny",
    },
    // Turn off OpenCode Zen models.
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
  ],
  // Model IDs: https://opencode.ai/docs/go/#endpoints
  "model": "opencode-go/claude-haiku-5-5",
  "default_agent": "plan",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
        },
      },
    },
  },
}
