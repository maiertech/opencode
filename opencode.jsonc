{
  "$schema": "https://opencode.ai/config.json",
  // Model IDs: https://opencode.ai/docs/go/#endpoints
  "model": "opencode-go/claude-haiku-5-5",
  // T3 Code cannot switch out of plan mode.
  "default_agent": "build",
  // Make home repo project skills available everywhere.
  "skills": ["~/repos/github/home/.agents/skills"],
  // Make home repo `AGENTS.md` available everywhere.
  "instructions": ["~/repos/github/home/AGENTS.md"],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}",
        },
      },
    },
  },
}
