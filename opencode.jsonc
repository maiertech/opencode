{
  "$schema": "https://opencode.ai/config.json",
  // `GITHUB_TOKEN` env var triggers Copilot models to be read.
  // Turn off OpenCode Zen models.
  "disabled_providers": ["github-copilot", "opencode"],
  // Model IDs: https://opencode.ai/docs/go/#endpoints
  "model": "opencode-go/glm-5.3-flash",
  "default_agent": "plan",
  "experimental": {
    "disable_paste_summary": true, // Required for voice dictation with OpenCode.
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
      },
    },
  },
}
